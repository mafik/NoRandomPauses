<vertical child-control-height='false' spacing='2' pad='4'>
  <toggle-setting text='Enabled' value='enabled' apply-on-change='true' />
  <slider-setting text='Suppression period' value='suppression-ms' min='50' max='3000' increment='50'
                  integer-only='true' apply-on-change='true' formatter='format-ms' />
</vertical>
